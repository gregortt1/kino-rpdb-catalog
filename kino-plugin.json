{
  "id": "rpdb-catalog",
  "name": "Catálogo con notas",
  "version": "1.11.0",
  "apiVersion": 6,
  "entry": "plugin.js",
  "catalogOnly": true,
  "discoverable": false,
  "section": { "label": "Con notas" },
  "theme": { "highlight": "#F5C518" },
  "description": "Catálogo de TMDB (tendencias, mejor valoradas, en cines y búsqueda) con los pósters, los fondos y los fotogramas de capítulo con la nota incrustada, y rellena el póster de los títulos de tus otras fuentes. La llave de TMDB la pone Kino; la del servidor de imágenes es tuya y es opcional.",
  "author": "gregorysteventt-source",
  "homepage": "https://github.com/gregorysteventt-source/kino-rpdb-catalog",
  "hosts": ["api.ratingposterdb.com", "openposterdb.com"],
  "capabilities": ["home", "browse", "search", "episodes", "meta", "resolve"],
  "color": "#F5C518",
  "icon": "icon.png",
  "settings": [
    {
      "key": "service",
      "label": "Servidor de imágenes",
      "type": "select",
      "default": "openposterdb",
      "options": [
        { "value": "openposterdb", "label": "OpenPosterDB (gratis)" },
        { "value": "rpdb", "label": "RatingPosterDB" }
      ]
    },
    {
      "key": "key",
      "label": "Clave del servidor",
      "type": "password",
      "default": "t0-free-rpdb",
      "hint": "Viene puesta la clave pública gratuita de OpenPosterDB"
    },
    {
      "key": "posterType",
      "label": "Tipo de póster",
      "type": "text",
      "default": "poster-default",
      "hint": "poster-default, poster-imdb-rated, poster-rt-rated…"
    },
    {
      "key": "tvRatings",
      "label": "En la tele: qué notas",
      "type": "select",
      "default": "imdb",
      "hint": "Con tres notas se usa el tamaño mediano, el único que cabe en una fila",
      "options": [
        { "value": "imdb", "label": "Solo IMDb (estricto)" },
        { "value": "imdbRt", "label": "IMDb y Rotten Tomatoes" },
        { "value": "imdbRtMc", "label": "IMDb, RT y Metacritic" },
        { "value": "imdbFallback", "label": "IMDb y si no hay, TMDB" },
        { "value": "auto", "label": "Automático (hasta 3)" }
      ]
    },
    {
      "key": "tvBadgeSize",
      "label": "En la tele: tamaño",
      "type": "select",
      "default": "sharp",
      "hint": "Solo en la tele, no en el celular",
      "options": [
        { "value": "sharp", "label": "Grandes (recomendado)" },
        { "value": "max", "label": "Muy grandes (imagen 4K, pesada)" },
        { "value": "normal", "label": "Medianas (como al principio)" }
      ]
    },
    {
      "key": "tvBadgePosition",
      "label": "En la tele: la nota del fondo",
      "type": "select",
      "default": "auto",
      "hint": "Solo los fondos; el póster y los capítulos van fijos",
      "options": [
        { "value": "auto", "label": "Como está (esquina arriba derecha)" },
        { "value": "bc", "label": "Abajo, centrada" },
        { "value": "tc", "label": "Arriba, centrada" },
        { "value": "l", "label": "A la izquierda" },
        { "value": "r", "label": "A la derecha" },
        { "value": "bl", "label": "Esquina abajo izquierda" },
        { "value": "br", "label": "Esquina abajo derecha" },
        { "value": "tl", "label": "Esquina arriba izquierda" },
        { "value": "tr", "label": "Esquina arriba derecha" }
      ]
    },
    {
      "key": "diag",
      "label": "Diagnóstico",
      "type": "section",
      "hint": "Comprueba qué imágenes sirve tu servidor"
    },
    {
      "key": "serverStatus",
      "label": "Qué funciona",
      "type": "status"
    },
    {
      "key": "testServer",
      "label": "Probar el servidor",
      "type": "action"
    }
  ]
}
