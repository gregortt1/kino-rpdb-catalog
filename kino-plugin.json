{
  "id": "rpdb-catalog",
  "name": "PosterX",
  "version": "1.30.0",
  "apiVersion": 9,
  "entry": "plugin.js",
  "catalogOnly": true,
  "categories": [
    "movies",
    "series"
  ],
  "section": {
    "label": "PosterX"
  },
  "theme": {
    "highlight": "#F5C518"
  },
  "description": "Cat\u00e1logo de TMDB con la nota incrustada en los p\u00f3sters, los fondos y los fotogramas de cap\u00edtulo: tendencias, populares, mejor valoradas, anime, documentales, infantil, doramas y g\u00e9neros. Rellena el p\u00f3ster de los t\u00edtulos de tus otras fuentes, no reproduce nada y no pide cuenta ni registro.",
  "author": "gregortt1",
  "homepage": "https://github.com/gregortt1/kino-rpdb-catalog",
  "hosts": [
    "api.ratingposterdb.com",
    "openposterdb.com"
  ],
  "capabilities": [
    "home",
    "browse",
    "search",
    "scopedSearch",
    "episodes",
    "meta",
    "resolve"
  ],
  "color": "#F5C518",
  "icon": "icon.png",
  "settings": [
    {
      "key": "servidor",
      "label": "Servidor",
      "type": "section",
      "labelEn": "Server"
    },
    {
      "key": "service",
      "label": "Servidor de im\u00e1genes",
      "type": "select",
      "default": "openposterdb",
      "options": [
        {
          "value": "openposterdb",
          "label": "OpenPosterDB (gratis)"
        },
        {
          "value": "rpdb",
          "label": "RatingPosterDB"
        }
      ],
      "labelEn": "Image server"
    },
    {
      "key": "key",
      "label": "Clave del servidor",
      "type": "text",
      "default": "t0-free-rpdb",
      "hint": "La clave p\u00fablica gratuita, ya puesta",
      "labelEn": "Server key",
      "hintEn": "The free public key, already set"
    },
    {
      "key": "posterSec",
      "label": "P\u00f3ster (en la tele)",
      "type": "section",
      "labelEn": "Poster (on TV)"
    },
    {
      "key": "posterRatings",
      "label": "Qu\u00e9 notas",
      "type": "select",
      "default": "imdbRtMc",
      "options": [
        {
          "value": "imdb",
          "label": "Solo IMDb (estricto)"
        },
        {
          "value": "imdbRt",
          "label": "IMDb y Rotten Tomatoes"
        },
        {
          "value": "imdbRtMal",
          "label": "IMDb y RT (+ MAL en anime)"
        },
        {
          "value": "imdbRtMc",
          "label": "IMDb, RT y Metacritic"
        },
        {
          "value": "imdbFallback",
          "label": "IMDb y si no hay, TMDB"
        },
        {
          "value": "auto",
          "label": "Autom\u00e1tico (hasta 3)"
        }
      ],
      "labelEn": "Which ratings"
    },
    {
      "key": "posterBadgeSize",
      "label": "Tama\u00f1o de la nota",
      "type": "select",
      "default": "sharp",
      "hint": "Con tres notas se encoge solo",
      "options": [
        {
          "value": "sharp",
          "label": "Grandes (recomendado)"
        },
        {
          "value": "max",
          "label": "Muy grandes"
        },
        {
          "value": "normal",
          "label": "Medianas"
        }
      ],
      "labelEn": "Rating badge size",
      "hintEn": "Three ratings shrink it by themselves"
    },
    {
      "key": "posterTextless",
      "label": "P\u00f3ster sin el t\u00edtulo",
      "type": "toggle",
      "default": false,
      "labelEn": "Poster without its title"
    },
    {
      "key": "posterType",
      "label": "Tipo de p\u00f3ster",
      "type": "text",
      "default": "poster-default",
      "hint": "poster-default; con RPDB, poster-imdb-rated",
      "labelEn": "Poster type",
      "hintEn": "poster-default; with RPDB, poster-imdb-rated"
    },
    {
      "key": "backdropSec",
      "label": "Fondo y cap\u00edtulos (en la tele)",
      "type": "section",
      "labelEn": "Backdrop and episodes (on TV)"
    },
    {
      "key": "backdropRatings",
      "label": "Qu\u00e9 notas",
      "type": "select",
      "default": "imdbRtMc",
      "hint": "Pueden ser distintas de las del p\u00f3ster",
      "options": [
        {
          "value": "imdb",
          "label": "Solo IMDb (estricto)"
        },
        {
          "value": "imdbRt",
          "label": "IMDb y Rotten Tomatoes"
        },
        {
          "value": "imdbRtMal",
          "label": "IMDb y RT (+ MAL en anime)"
        },
        {
          "value": "imdbRtMc",
          "label": "IMDb, RT y Metacritic"
        },
        {
          "value": "all",
          "label": "Todas las que haya (hasta 8)"
        },
        {
          "value": "imdbFallback",
          "label": "IMDb y si no hay, TMDB"
        },
        {
          "value": "auto",
          "label": "Autom\u00e1tico (hasta 3)"
        }
      ],
      "labelEn": "Which ratings",
      "hintEn": "Can differ from the poster's"
    },
    {
      "key": "backdropBadgeSize",
      "label": "Tama\u00f1o de la nota",
      "type": "select",
      "default": "sharp",
      "options": [
        {
          "value": "sharp",
          "label": "Grandes (recomendado)"
        },
        {
          "value": "max",
          "label": "Muy grandes (imagen 4K, pesada)"
        },
        {
          "value": "normal",
          "label": "Medianas"
        }
      ],
      "labelEn": "Rating badge size"
    },
    {
      "key": "backdropPosition",
      "label": "D\u00f3nde va la nota",
      "type": "select",
      "default": "r",
      "hint": "Solo el fondo",
      "options": [
        {
          "value": "r",
          "label": "Centrada a la derecha (recomendado)"
        },
        {
          "value": "l",
          "label": "Centrada a la izquierda"
        },
        {
          "value": "bc",
          "label": "Abajo, centrada"
        },
        {
          "value": "tc",
          "label": "Arriba, centrada"
        },
        {
          "value": "bl",
          "label": "Esquina abajo izquierda"
        },
        {
          "value": "br",
          "label": "Esquina abajo derecha"
        },
        {
          "value": "tl",
          "label": "Esquina arriba izquierda"
        },
        {
          "value": "tr",
          "label": "Esquina arriba derecha"
        }
      ],
      "labelEn": "Where the rating goes",
      "hintEn": "Backdrop only"
    },
    {
      "key": "diag",
      "label": "Diagn\u00f3stico",
      "type": "section",
      "labelEn": "Diagnostics"
    },
    {
      "key": "serverStatus",
      "label": "Qu\u00e9 funciona",
      "type": "status",
      "labelEn": "What works"
    },
    {
      "key": "testServer",
      "label": "Probar el servidor",
      "type": "action",
      "labelEn": "Test the server"
    },
    {
      "key": "comoBuscar",
      "label": "C\u00f3mo buscar",
      "type": "section",
      "hint": "Aqu\u00ed no hay lupa arriba: Kino solo la muestra a los plugins que reproducen, y este es un cat\u00e1logo. Se busca dentro de cada categor\u00eda: entra en G\u00e9neros, abre un g\u00e9nero y toca \u00abBuscar en esta categor\u00eda\u00bb. Tambi\u00e9n en el \u00abVer m\u00e1s\u00bb de cualquier fila.",
      "labelEn": "How to search",
      "hintEn": "No magnifier up here: Kino only shows it to plugins that play, and this is a catalogue. Search inside a category: open Genres, pick one and tap \u00abSearch in this category\u00bb. Also in the \u00abSee more\u00bb of any row."
    }
  ]
}
