{
  "id": "rpdb-catalog",
  "name": "PosterX",
  "version": "1.24.0",
  "apiVersion": 6,
  "entry": "plugin.js",
  "catalogOnly": true,
  "categories": [
    "movies",
    "series"
  ],
  "section": {
    "label": "PosterX"
  },
  "theme": {
    "highlight": "#F5C518"
  },
  "description": "Cat\u00e1logo de TMDB con la nota incrustada en los p\u00f3sters, los fondos y los fotogramas de cap\u00edtulo: tendencias, populares, mejor valoradas, anime, documentales, infantil, doramas y g\u00e9neros. Rellena el p\u00f3ster de los t\u00edtulos de tus otras fuentes, no reproduce nada y no pide cuenta ni registro.",
  "author": "gregorysteventt-source",
  "homepage": "https://github.com/gregorysteventt-source/kino-rpdb-catalog",
  "hosts": [
    "api.ratingposterdb.com",
    "openposterdb.com"
  ],
  "capabilities": [
    "home",
    "browse",
    "search",
    "episodes",
    "meta",
    "resolve"
  ],
  "color": "#F5C518",
  "icon": "icon.png",
  "settings": [
    {
      "key": "servidor",
      "label": "Servidor",
      "type": "section"
    },
    {
      "key": "service",
      "label": "Servidor de im\u00e1genes",
      "type": "select",
      "default": "openposterdb",
      "options": [
        {
          "value": "openposterdb",
          "label": "OpenPosterDB (gratis)"
        },
        {
          "value": "rpdb",
          "label": "RatingPosterDB"
        }
      ]
    },
    {
      "key": "key",
      "label": "Clave del servidor",
      "type": "text",
      "default": "t0-free-rpdb",
      "hint": "La clave p\u00fablica gratuita, ya puesta"
    },
    {
      "key": "posterSec",
      "label": "P\u00f3ster (en la tele)",
      "type": "section"
    },
    {
      "key": "posterRatings",
      "label": "Qu\u00e9 notas",
      "type": "select",
      "default": "imdbRtMc",
      "options": [
        {
          "value": "imdb",
          "label": "Solo IMDb (estricto)"
        },
        {
          "value": "imdbRt",
          "label": "IMDb y Rotten Tomatoes"
        },
        {
          "value": "imdbRtMal",
          "label": "IMDb y RT (+ MAL en anime)"
        },
        {
          "value": "imdbRtMc",
          "label": "IMDb, RT y Metacritic"
        },
        {
          "value": "imdbFallback",
          "label": "IMDb y si no hay, TMDB"
        },
        {
          "value": "auto",
          "label": "Autom\u00e1tico (hasta 3)"
        }
      ]
    },
    {
      "key": "posterBadgeSize",
      "label": "Tama\u00f1o de la nota",
      "type": "select",
      "default": "sharp",
      "hint": "Con tres notas se encoge solo",
      "options": [
        {
          "value": "sharp",
          "label": "Grandes (recomendado)"
        },
        {
          "value": "max",
          "label": "Muy grandes"
        },
        {
          "value": "normal",
          "label": "Medianas"
        }
      ]
    },
    {
      "key": "posterTextless",
      "label": "P\u00f3ster sin el t\u00edtulo",
      "type": "toggle",
      "default": false
    },
    {
      "key": "posterType",
      "label": "Tipo de p\u00f3ster",
      "type": "text",
      "default": "poster-default",
      "hint": "poster-default; con RPDB, poster-imdb-rated"
    },
    {
      "key": "backdropSec",
      "label": "Fondo y cap\u00edtulos (en la tele)",
      "type": "section"
    },
    {
      "key": "backdropRatings",
      "label": "Qu\u00e9 notas",
      "type": "select",
      "default": "imdbRtMc",
      "hint": "Pueden ser distintas de las del p\u00f3ster",
      "options": [
        {
          "value": "imdb",
          "label": "Solo IMDb (estricto)"
        },
        {
          "value": "imdbRt",
          "label": "IMDb y Rotten Tomatoes"
        },
        {
          "value": "imdbRtMal",
          "label": "IMDb y RT (+ MAL en anime)"
        },
        {
          "value": "imdbRtMc",
          "label": "IMDb, RT y Metacritic"
        },
        {
          "value": "all",
          "label": "Todas las que haya (hasta 8)"
        },
        {
          "value": "imdbFallback",
          "label": "IMDb y si no hay, TMDB"
        },
        {
          "value": "auto",
          "label": "Autom\u00e1tico (hasta 3)"
        }
      ]
    },
    {
      "key": "backdropBadgeSize",
      "label": "Tama\u00f1o de la nota",
      "type": "select",
      "default": "sharp",
      "options": [
        {
          "value": "sharp",
          "label": "Grandes (recomendado)"
        },
        {
          "value": "max",
          "label": "Muy grandes (imagen 4K, pesada)"
        },
        {
          "value": "normal",
          "label": "Medianas"
        }
      ]
    },
    {
      "key": "backdropPosition",
      "label": "D\u00f3nde va la nota",
      "type": "select",
      "default": "r",
      "hint": "Solo el fondo",
      "options": [
        {
          "value": "r",
          "label": "Centrada a la derecha (recomendado)"
        },
        {
          "value": "l",
          "label": "Centrada a la izquierda"
        },
        {
          "value": "bc",
          "label": "Abajo, centrada"
        },
        {
          "value": "tc",
          "label": "Arriba, centrada"
        },
        {
          "value": "bl",
          "label": "Esquina abajo izquierda"
        },
        {
          "value": "br",
          "label": "Esquina abajo derecha"
        },
        {
          "value": "tl",
          "label": "Esquina arriba izquierda"
        },
        {
          "value": "tr",
          "label": "Esquina arriba derecha"
        }
      ]
    },
    {
      "key": "diag",
      "label": "Diagn\u00f3stico",
      "type": "section"
    },
    {
      "key": "serverStatus",
      "label": "Qu\u00e9 funciona",
      "type": "status"
    },
    {
      "key": "testServer",
      "label": "Probar el servidor",
      "type": "action"
    }
  ]
}
