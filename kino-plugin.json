{
  "id": "rpdb-catalog",
  "name": "OpenPoster",
  "version": "1.15.0",
  "apiVersion": 9,
  "entry": "plugin.js",
  "catalogOnly": true,
  "discoverable": false,
  "categories": ["movies", "series"],
  "section": { "label": "OpenPoster" },
  "theme": { "highlight": "#F5C518" },
  "description": "Catálogo de TMDB (tendencias, populares, mejor valoradas, anime, documentales y géneros) con los pósters, los fondos y los fotogramas de capítulo con la nota incrustada. Rellena el póster de los títulos de tus otras fuentes y no reproduce nada.",
  "author": "gregorysteventt-source",
  "homepage": "https://github.com/gregorysteventt-source/kino-rpdb-catalog",
  "hosts": ["api.ratingposterdb.com", "openposterdb.com"],
  "capabilities": ["home", "browse", "search", "episodes", "meta", "resolve"],
  "color": "#F5C518",
  "icon": "icon.png",
  "settings": [
    {
      "key": "service",
      "label": "Servidor de imágenes",
      "type": "select",
      "default": "openposterdb",
      "hint": "OpenPosterDB es gratis y también sirve fondos y capítulos",
      "options": [
        { "value": "openposterdb", "label": "OpenPosterDB (gratis)" },
        { "value": "rpdb", "label": "RatingPosterDB" }
      ]
    },
    {
      "key": "key",
      "label": "Clave del servidor",
      "type": "password",
      "default": "t0-free-rpdb",
      "hint": "Viene puesta la clave pública gratuita de OpenPosterDB"
    },
    {
      "key": "posterRatings",
      "label": "Qué notas",
      "type": "select",
      "default": "imdbRtMc",
      "hint": "Con tres notas se usa el tamaño mediano, el único que cabe en una fila",
      "options": [
        { "value": "imdb", "label": "Solo IMDb (estricto)" },
        { "value": "imdbRt", "label": "IMDb y Rotten Tomatoes" },
        { "value": "imdbRtMc", "label": "IMDb, RT y Metacritic" },
        { "value": "imdbFallback", "label": "IMDb y si no hay, TMDB" },
        { "value": "auto", "label": "Automático (hasta 3)" }
      ]
    },
    {
      "key": "posterBadgeSize",
      "label": "Tamaño de la nota",
      "type": "select",
      "default": "sharp",
      "hint": "Si son tres notas se encoge solo, para que quepan en una fila",
      "options": [
        { "value": "sharp", "label": "Grandes (recomendado)" },
        { "value": "max", "label": "Muy grandes" },
        { "value": "normal", "label": "Medianas" }
      ]
    },
    {
      "key": "posterTextless",
      "label": "Póster sin el título",
      "type": "toggle",
      "default": false,
      "hint": "Quita el texto del arte; las notas se leen mucho mejor"
    },
    {
      "key": "posterType",
      "label": "Tipo de póster",
      "type": "text",
      "default": "poster-default",
      "hint": "poster-default; con RatingPosterDB, poster-imdb-rated…"
    },
    {
      "key": "backdropRatings",
      "label": "Qué notas",
      "type": "select",
      "default": "imdbRtMc",
      "hint": "Pueden ser distintas de las del póster",
      "options": [
        { "value": "imdb", "label": "Solo IMDb (estricto)" },
        { "value": "imdbRt", "label": "IMDb y Rotten Tomatoes" },
        { "value": "imdbRtMc", "label": "IMDb, RT y Metacritic" },
        { "value": "all", "label": "Todas las que haya (hasta 8)" },
        { "value": "imdbFallback", "label": "IMDb y si no hay, TMDB" },
        { "value": "auto", "label": "Automático (hasta 3)" }
      ]
    },
    {
      "key": "backdropBadgeSize",
      "label": "Tamaño de la nota",
      "type": "select",
      "default": "sharp",
      "hint": "Cuanto más grandes, menos notas caben",
      "options": [
        { "value": "sharp", "label": "Grandes (recomendado)" },
        { "value": "max", "label": "Muy grandes (imagen 4K, pesada)" },
        { "value": "normal", "label": "Medianas" }
      ]
    },
    {
      "key": "backdropPosition",
      "label": "Dónde va la nota",
      "type": "select",
      "default": "auto",
      "hint": "Solo el fondo; el póster va abajo y el capítulo arriba",
      "options": [
        { "value": "auto", "label": "Como está (esquina arriba derecha)" },
        { "value": "bc", "label": "Abajo, centrada" },
        { "value": "tc", "label": "Arriba, centrada" },
        { "value": "l", "label": "A la izquierda" },
        { "value": "r", "label": "A la derecha" },
        { "value": "bl", "label": "Esquina abajo izquierda" },
        { "value": "br", "label": "Esquina abajo derecha" },
        { "value": "tl", "label": "Esquina arriba izquierda" },
        { "value": "tr", "label": "Esquina arriba derecha" }
      ]
    },
    {
      "key": "serverStatus",
      "label": "Qué funciona",
      "type": "status"
    },
    {
      "key": "testServer",
      "label": "Probar el servidor",
      "type": "action"
    }
  ],
  "settingsLayout": [
    {
      "type": "card",
      "title": "Servidor",
      "children": [
        { "type": "text", "text": "De aquí salen todas las imágenes con nota." },
        { "type": "row", "children": [{ "setting": "service" }, { "setting": "key" }] }
      ]
    },
    {
      "type": "card",
      "title": "Póster",
      "children": [
        { "type": "text", "text": "Es vertical: la nota va abajo, centrada, y no se mueve. Solo en la tele." },
        { "type": "row", "children": [{ "setting": "posterRatings" }, { "setting": "posterBadgeSize" }] },
        { "type": "row", "children": [{ "setting": "posterTextless" }, { "setting": "posterType" }] }
      ]
    },
    {
      "type": "card",
      "title": "Fondo y capítulos",
      "children": [
        { "type": "text", "text": "Son apaisados y caben más notas. Solo en la tele." },
        { "type": "row", "children": [{ "setting": "backdropRatings" }, { "setting": "backdropBadgeSize" }] },
        { "setting": "backdropPosition" }
      ]
    },
    {
      "type": "card",
      "title": "Diagnóstico",
      "children": [
        { "type": "text", "text": "Comprueba qué imágenes sirve tu servidor." },
        { "type": "row", "children": [{ "setting": "serverStatus" }, { "setting": "testServer" }] }
      ]
    }
  ]
}
